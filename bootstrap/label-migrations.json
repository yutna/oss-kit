{
  "rename": [
    { "from": "feature", "to": "enhancement" },
    { "from": "proposal", "to": "enhancement" },
    { "from": "breaking-change", "to": "breaking" },
    { "from": "priority: p1", "to": "priority: high" },
    { "from": "priority: p3", "to": "priority: low" }
  ],
  "delete": [
    "priority: medium",
    "priority: p2",
    "triage",
    "hotfix",
    "release",
    "duplicate",
    "invalid",
    "wontfix",
    "javascript",
    "github_actions"
  ],
  "extensions": {
    "yutna/functional-design-skills": ["skill"],
    "yutna/gherkin-specification-skills": ["skill"],
    "yutna/ollama-bar": ["area: app", "area: ci", "accessibility", "localization"],
    "yutna/pixel-factory": [
      "agent:ready", "agent:running", "agent:review", "agent:blocked", "agent:done",
      "ai-generated", "hold", "accessibility"
    ],
    "yutna/agent-workflow-template": [
      "agent:ready", "agent:running", "agent:review", "agent:blocked", "agent:done",
      "ai-generated", "hold", "accessibility"
    ]
  }
}
