{
  "rename": [
    { "from": "feature", "to": "enhancement" },
    { "from": "breaking-change", "to": "breaking" },
    { "from": "priority: p1", "to": "priority: high" },
    { "from": "priority: p3", "to": "priority: low" }
  ],
  "delete": [
    "priority: medium",
    "priority: p2",
    "triage",
    "hotfix",
    "release",
    "duplicate",
    "invalid",
    "wontfix",
    "javascript",
    "github_actions"
  ],
  "extensions": {
    "yutna/functional-design-skills": ["skill", "proposal"],
    "yutna/gherkin-specification-skills": ["skill", "proposal"],
    "yutna/ollama-bar": ["area: app", "area: ci", "accessibility", "localization"]
  }
}
