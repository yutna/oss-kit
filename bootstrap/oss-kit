#!/usr/bin/env bash
# oss-kit — create public repositories and keep them on the shared workflow.
# Conventions: docs/conventions.md. Tests: test/cli.test.mjs.
#
# Bash 3.2 compatible (macOS /bin/bash): no associative arrays, no mapfile,
# no ${var,,}; empty arrays are never expanded under set -u. Depends only on
# gh, git, jq and perl. Every step reads first and changes only what differs,
# so running it twice changes nothing the second time.
set -euo pipefail

OWNER="${OSS_KIT_OWNER:-yutna}"
FULLNAME="${OSS_KIT_FULLNAME:-Yutthana Siphuengchai}"
TEMPLATE="$OWNER/oss-template"
KIT_REPO="$OWNER/oss-kit"
STACKS="node java-maven java-gradle ruby swift python go elixir none"
US=$'\x1f' # field separator for plans: unlike a tab, it keeps empty fields

DESIRED_SETTINGS='{
  "has_issues": true, "has_wiki": false, "has_projects": false, "has_discussions": false,
  "allow_squash_merge": true, "allow_merge_commit": false, "allow_rebase_merge": false,
  "delete_branch_on_merge": true, "allow_auto_merge": true, "allow_update_branch": true,
  "squash_merge_commit_title": "PR_TITLE", "squash_merge_commit_message": "BLANK"
}'

REQUIRED_FILES="LICENSE README.md CONTRIBUTING.md CODE_OF_CONDUCT.md SECURITY.md SUPPORT.md
.editorconfig .gitattributes .github/pull_request_template.md .github/dependabot.yml
.github/release.yml .github/ISSUE_TEMPLATE/config.yml .github/ISSUE_TEMPLATE/bug_report.yml
.github/ISSUE_TEMPLATE/feature_request.yml .github/ISSUE_TEMPLATE/question.yml"

# The bootstrap directory, also when the CLI is reached through a symlink.
kit_dir() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -h "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")" && pwd
}
KIT_DIR=$(kit_dir)

usage() {
  cat <<'EOF'
usage: oss-kit new <name> --description "<text>" [--topics a,b,c] [--stack <stack>]
                          [--dir ~/Projects] [--dry-run] [--resume]
       oss-kit apply <owner/repo> [--dry-run] [--migrate-labels] [--prune-labels]
                          [--skip-rulesets] [--topics a,b,c] [--milestone vX.Y.Z]
       oss-kit doctor <owner/repo>

  new     create <owner>/<name> from oss-template, fill placeholders, add stack
          extras, push, then apply. --resume finishes a new that stopped part-way.
  apply   bring settings, security, labels, milestones and rulesets in line.
  doctor  read-only: report drift from the spec; exit 1 when there is any.

stacks: node java-maven java-gradle ruby swift python go elixir none
Only public repositories are touched.
EOF
}

log() { printf '%s\n' "$*" >&2; }
step() { printf '\n== %s\n' "$*" >&2; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}
usage_error() {
  printf 'error: %s\n\n' "$*" >&2
  usage >&2
  exit 2
}

# --- pure functions (tested) -------------------------------------------------

# label_plan CURRENT_JSON REPO MIGRATE(0|1) PRUNE(0|1)
# Prints one operation per line, fields separated by $US:
#   rename FROM TO | merge FROM TO | delete NAME | upsert NAME COLOR DESCRIPTION | prune NAME
#   pending FROM TO (prune without migrate: left for --migrate-labels)
label_plan() {
  jq -r --slurpfile core "$KIT_DIR/labels.json" --slurpfile mig "$KIT_DIR/label-migrations.json" \
    --arg repo "$2" --argjson migrate "$3" --argjson prune "$4" --arg us "$US" '
    def lc: ascii_downcase;
    def named($n): map(select(.name | lc == ($n | lc))) | first;
    def exists($n): any(.[]; .name | lc == ($n | lc));
    $core[0] as $core | $mig[0] as $mig
    | { labels: ., ops: [] }
    | if $migrate == 1 then
        reduce $mig.rename[] as $r (.;
          (.labels | named($r.from)) as $from
          | if $from == null then .
            elif (.labels | exists($r.to)) then
              .ops += [["merge", $from.name, $r.to]]
              | .labels |= map(select(.name | lc != ($r.from | lc)))
            else
              .ops += [["rename", $from.name, $r.to]]
              | .labels |= map(if (.name | lc) == ($r.from | lc) then .name = $r.to else . end)
            end)
        | reduce $mig.delete[] as $d (.;
            (.labels | named($d)) as $hit
            | if $hit == null then .
              else .ops += [["delete", $hit.name]] | .labels |= map(select(.name | lc != ($d | lc)))
              end)
      else . end
    | reduce $core[] as $c (.;
        (.labels | named($c.name)) as $have
        | if $have != null and ($have.color | lc) == $c.color and ($have.description // "") == $c.description
          then .
          else .ops += [["upsert", $c.name, $c.color, $c.description]]
          end)
    | if $prune == 1 then
        (([$core[].name] + ($mig.extensions[$repo] // [])) | map(lc)) as $keep
        # Without --migrate-labels, a label a migration would rename is left
        # alone (reported as pending), never pruned.
        | (if $migrate == 1 then [] else $mig.rename end) as $renames
        | .ops += [.labels[] | .name as $name
            | ($renames | map(select((.from | lc) == ($name | lc))) | first) as $r
            | if $r != null then ["pending", $name, $r.to]
              elif ($keep | index($name | lc)) then empty
              else ["prune", $name] end]
      else . end
    | .ops[] | join($us)
  ' "$1"
}

# settings_drift REPO_JSON — prints "key<US>current<US>desired" per difference.
settings_drift() {
  jq -r --argjson want "$DESIRED_SETTINGS" --arg us "$US" '
    . as $have | $want | to_entries[]
    | select($have[.key] != .value)
    | [.key, ($have[.key] | tostring), (.value | tostring)] | join($us)
  ' "$1"
}

# json_subset SPEC_JSON ACTUAL_JSON — exit 0 when every value in the spec is
# also in the actual object. Rules are compared by type, arrays as sets, and
# keys GitHub adds (ids, links, new defaults) are ignored.
json_subset() {
  jq -e -n --slurpfile s "$1" --slurpfile a "$2" '
    def norm:
      (if type == "object" and has("rules")
       then .rules |= (map({ key: .type, value: (.parameters // {}) }) | from_entries)
       else . end)
      | walk(if type == "array" then sort else . end);
    def subset($a):
      if type == "object"
      then ($a | type) == "object" and all(to_entries[]; .key as $k | .value | subset($a[$k]))
      else . == $a end;
    ($s[0] | norm) | subset($a[0] | norm)
  ' > /dev/null
}

# fill_placeholders DIR REPO DESCRIPTION — replaces {{YEAR}} {{OWNER}} {{REPO}}
# {{DESCRIPTION}} {{FULLNAME}} in tracked files; fails if any {{UPPER}} is left.
fill_placeholders() {
  local dir="$1" files left
  files=$(git -C "$dir" grep -lE '\{\{(YEAR|OWNER|REPO|DESCRIPTION|FULLNAME)\}\}' || true)
  if [ -n "$files" ]; then
    printf '%s\n' "$files" | while IFS= read -r f; do
      OSK_YEAR=$(date +%Y) OSK_OWNER="$OWNER" OSK_REPO="$2" OSK_DESCRIPTION="$3" OSK_FULLNAME="$FULLNAME" \
        perl -pi -e 's/\{\{YEAR\}\}/$ENV{OSK_YEAR}/g; s/\{\{OWNER\}\}/$ENV{OSK_OWNER}/g;
          s/\{\{REPO\}\}/$ENV{OSK_REPO}/g; s/\{\{DESCRIPTION\}\}/$ENV{OSK_DESCRIPTION}/g;
          s/\{\{FULLNAME\}\}/$ENV{OSK_FULLNAME}/g' "$dir/$f"
    done
  fi
  left=$(git -C "$dir" grep -nE '\{\{[A-Z_]+\}\}' || true)
  [ -z "$left" ] || die "placeholders left after filling: $left"
}

valid_stack() {
  case " $STACKS " in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

# gitignore template names (github/gitignore) for a stack, space-separated.
stack_gitignore() {
  case "$1" in
    node) echo Node ;;
    java-maven) echo "Java Maven" ;;
    java-gradle) echo "Java Gradle" ;;
    ruby) echo Ruby ;;
    swift) echo Swift ;;
    python) echo Python ;;
    go) echo Go ;;
    elixir) echo Elixir ;;
    none) echo "" ;;
    *) return 1 ;;
  esac
}

stack_ecosystem() {
  case "$1" in
    node) echo npm ;;
    java-maven) echo maven ;;
    java-gradle) echo gradle ;;
    ruby) echo bundler ;;
    swift) echo swift ;;
    python) echo pip ;;
    go) echo gomod ;;
    elixir) echo mix ;;
    none) echo "" ;;
    *) return 1 ;;
  esac
}

# add_stack_extras DIR STACK — appends the stack's gitignore templates and
# Dependabot entry, once: running it again (new --resume) adds nothing.
add_stack_extras() {
  local dir="$1" t src eco
  for t in $(stack_gitignore "$2"); do
    ! grep -qxF "# --- $t (github/gitignore) ---" "$dir/.gitignore" 2> /dev/null || continue
    src=$(gh api "gitignore/templates/$t" --jq .source) || die "cannot fetch the $t gitignore template"
    printf '\n# --- %s (github/gitignore) ---\n%s\n' "$t" "$src" >> "$dir/.gitignore"
  done
  eco=$(stack_ecosystem "$2")
  [ -z "$eco" ] || grep -qE "^  - package-ecosystem: $eco$" "$dir/.github/dependabot.yml" ||
    dependabot_block "$eco" >> "$dir/.github/dependabot.yml"
}

# A Dependabot "updates" entry with the core conventions. Minor and patch
# updates are grouped into one pull request; majors arrive one by one.
dependabot_block() {
  cat <<EOF
  - package-ecosystem: $1
    directory: /
    schedule:
      interval: weekly
    groups:
      $1:
        update-types: [minor, patch]
    labels: [dependencies]
    assignees: [$OWNER]
    commit-message:
      prefix: chore
      include: scope
EOF
}

# --- change or report ----------------------------------------------------------

MODE="apply" # apply | dry-run | doctor
DRIFT=0

# act DESCRIPTION COMMAND... — runs COMMAND in apply mode; otherwise reports it.
act() {
  local what="$1"
  shift
  case "$MODE" in
    apply)
      log "  -> $what"
      "$@"
      ;;
    dry-run)
      log "  would: $what"
      DRIFT=$((DRIFT + 1))
      ;;
    doctor)
      log "  DRIFT: $what"
      DRIFT=$((DRIFT + 1))
      ;;
  esac
}

# --- checks (each reads, then acts on the difference) -------------------------

REPO=""
REPO_JSON=""
WORK=""

load_repo() {
  REPO="$1"
  REPO_JSON="$WORK/repo.json"
  gh api "repos/$REPO" > "$REPO_JSON" || die "cannot read $REPO"
  [ "$(jq -r .visibility "$REPO_JSON")" = public ] ||
    die "$REPO is not public: oss-kit never touches private repositories"
  [ "$(jq -r .owner.login "$REPO_JSON")" = "$OWNER" ] ||
    die "$REPO is not owned by $OWNER: oss-kit only manages $OWNER's repositories"
  [ "$(jq -r .permissions.admin "$REPO_JSON")" = true ] || die "you are not an admin of $REPO"
  # GitHub's spelling, so per-repository extensions are found however it was typed.
  REPO=$(jq -r .full_name "$REPO_JSON")
}

check_settings() {
  step "settings"
  local drift summary="" key have want
  drift=$(settings_drift "$REPO_JSON")
  if [ -z "$drift" ]; then
    log "  ok"
    return
  fi
  while IFS="$US" read -r key have want; do
    summary="$summary${summary:+, }$key $have->$want"
  done <<< "$drift"
  act "settings: $summary" gh api -X PATCH "repos/$REPO" --input - --silent <<< "$DESIRED_SETTINGS"
}

check_topics() {
  local topics="$1" t missing=""
  [ -n "$topics" ] || return 0
  step "topics"
  for t in $(printf '%s' "$topics" | tr ',' ' '); do
    jq -e --arg t "$t" '.topics | index($t)' "$REPO_JSON" > /dev/null || missing="$missing $t"
  done
  if [ -z "$missing" ]; then
    log "  ok"
    return
  fi
  set -- # build --add-topic arguments without arrays
  for t in $missing; do set -- "$@" --add-topic "$t"; done
  act "add topics:$missing" gh repo edit "$REPO" "$@"
}

check_actions() {
  step "actions"
  local cur
  cur=$(gh api "repos/$REPO/actions/permissions/workflow" \
    --jq '"\(.default_workflow_permissions) \(.can_approve_pull_request_reviews)"')
  if [ "$cur" = "read false" ]; then
    log "  ok"
    return
  fi
  act "default GITHUB_TOKEN permissions: $cur -> read false" \
    gh api -X PUT "repos/$REPO/actions/permissions/workflow" \
    -f default_workflow_permissions=read -F can_approve_pull_request_reviews=false --silent
}

codeql_setup() {
  gh api -X PATCH "repos/$1/code-scanning/default-setup" -f state=configured --silent ||
    warn "CodeQL default setup failed (no supported language yet?); run apply again later"
}

check_security() {
  step "security"
  local clean=1 v ss pp
  if ! gh api "repos/$REPO/vulnerability-alerts" --silent 2> /dev/null; then
    clean=0
    act "enable Dependabot alerts" gh api -X PUT "repos/$REPO/vulnerability-alerts" --silent
  fi
  v=$(gh api "repos/$REPO/automated-security-fixes" --jq .enabled 2> /dev/null || echo false)
  if [ "$v" != true ]; then
    clean=0
    act "enable Dependabot security updates" gh api -X PUT "repos/$REPO/automated-security-fixes" --silent
  fi
  v=$(gh api "repos/$REPO/private-vulnerability-reporting" --jq .enabled 2> /dev/null || echo false)
  if [ "$v" != true ]; then
    clean=0
    act "enable private vulnerability reporting" \
      gh api -X PUT "repos/$REPO/private-vulnerability-reporting" --silent
  fi
  ss=$(jq -r '.security_and_analysis.secret_scanning.status // "unknown"' "$REPO_JSON")
  pp=$(jq -r '.security_and_analysis.secret_scanning_push_protection.status // "unknown"' "$REPO_JSON")
  if [ "$ss" != enabled ] || [ "$pp" != enabled ]; then
    clean=0
    act "secret scanning ($ss) and push protection ($pp) -> enabled" \
      gh api -X PATCH "repos/$REPO" --input - --silent <<< \
      '{"security_and_analysis":{"secret_scanning":{"status":"enabled"},"secret_scanning_push_protection":{"status":"enabled"}}}'
  fi
  v=$(gh api "repos/$REPO/code-scanning/default-setup" --jq .state 2> /dev/null || echo unknown)
  if [ "$v" != configured ]; then
    clean=0
    act "CodeQL default setup ($v) -> configured" codeql_setup "$REPO"
  fi
  [ "$clean" = 0 ] || log "  ok"
}

# Moves every issue and pull request labelled FROM to TO, then deletes FROM.
label_merge() {
  local nums n
  # A failed listing must stop here: deleting the label would strip it from
  # every item that was not moved.
  nums=$(gh api -X GET "repos/$REPO/issues" -f labels="$1" -f state=all -f per_page=100 \
    --paginate --jq '.[].number') || die "cannot list the items labelled \"$1\"; nothing was deleted"
  for n in $nums; do
    gh api -X POST "repos/$REPO/issues/$n/labels" -f "labels[]=$2" --silent
  done
  gh label delete "$1" --yes -R "$REPO"
}

check_labels() {
  step "labels"
  local current="$WORK/labels.json" plan="$WORK/labels.plan" op a b c
  gh label list -R "$REPO" --limit 500 --json name,color,description > "$current"
  label_plan "$current" "$REPO" "$1" "$2" > "$plan"
  if [ ! -s "$plan" ]; then
    log "  ok"
    return
  fi
  while IFS="$US" read -r -u 3 op a b c; do
    case "$op" in
      rename) act "rename label \"$a\" -> \"$b\"" gh label edit "$a" --name "$b" -R "$REPO" ;;
      merge) act "move items labelled \"$a\" to \"$b\", delete \"$a\"" label_merge "$a" "$b" ;;
      delete) act "delete label \"$a\" (migration)" gh label delete "$a" --yes -R "$REPO" ;;
      upsert) act "set label \"$a\" #$b \"$c\"" \
        gh label create "$a" --color "$b" --description "$c" --force -R "$REPO" ;;
      prune) act "delete label \"$a\" (not core, not an extension)" gh label delete "$a" --yes -R "$REPO" ;;
      pending)
        if [ "$MODE" = apply ]; then
          warn "label \"$a\" left alone: run apply with --migrate-labels to turn it into \"$b\""
        else
          act "label \"$a\" needs --migrate-labels (-> \"$b\")" true
        fi
        ;;
    esac
  done 3< "$plan"
}

check_milestones() {
  step "milestones"
  local list="$WORK/milestones" extra="$1" clean=1 line
  gh api "repos/$REPO/milestones?state=all&per_page=100" --paginate \
    --jq '.[] | [.title, .state, (.number | tostring)] | join("\u001f")' > "$list"
  line=$(grep -m1 "^Backlog$US" "$list" || true)
  if [ -z "$line" ]; then
    clean=0
    act "create milestone Backlog" gh api -X POST "repos/$REPO/milestones" \
      -f title=Backlog -f description="Parking lot. Never released." --silent
  elif [ "$(printf '%s' "$line" | cut -d "$US" -f 2)" != open ]; then
    clean=0
    act "reopen milestone Backlog (it is never closed)" gh api -X PATCH \
      "repos/$REPO/milestones/$(printf '%s' "$line" | cut -d "$US" -f 3)" -f state=open --silent
  fi
  if [ -n "$extra" ] && ! grep -q "^$extra$US" "$list"; then
    clean=0
    act "create milestone $extra" gh api -X POST "repos/$REPO/milestones" -f title="$extra" --silent
  fi
  [ "$clean" = 0 ] || log "  ok"
}

check_rulesets() {
  step "rulesets"
  local spec name id actual="$WORK/ruleset.json"
  for spec in "$KIT_DIR/ruleset-main.json" "$KIT_DIR/ruleset-tags.json"; do
    name=$(jq -r .name "$spec")
    id=$(gh api "repos/$REPO/rulesets?includes_parents=false" |
      jq -r --arg n "$name" '[.[] | select(.name == $n and .source_type == "Repository")][0].id // empty')
    if [ -z "$id" ] && [ "$name" = main ] && ! gate_ready; then
      # Required checks that never report would lock main for good.
      warn "skipped ruleset \"main\": the default branch of $REPO has no ci-ok gate or pr-check caller"
      warn "  yet; merge the pull request that adds them, then run apply again"
      [ "$MODE" = apply ] || DRIFT=$((DRIFT + 1))
    elif [ -z "$id" ]; then
      act "create ruleset \"$name\"" gh api -X POST "repos/$REPO/rulesets" --input "$spec" --silent
    else
      gh api "repos/$REPO/rulesets/$id" > "$actual"
      if json_subset "$spec" "$actual"; then
        log "  ok: $name"
      else
        act "update ruleset \"$name\" (#$id)" gh api -X PUT "repos/$REPO/rulesets/$id" --input "$spec" --silent
      fi
    fi
  done
}

# Classic branch protection is replaced by the rulesets, but removing it is
# left to a person (it is hard to reverse), so this only reports it.
check_classic_protection() {
  local branch
  branch=$(jq -r .default_branch "$REPO_JSON")
  if gh api "repos/$REPO/branches/$branch/protection" --silent 2> /dev/null; then
    warn "$REPO has classic branch protection on $branch; remove it once the rulesets are in place:"
    warn "  gh api -X DELETE repos/$REPO/branches/$branch/protection"
    [ "$MODE" != doctor ] || DRIFT=$((DRIFT + 1))
  fi
}

# Fetches the default branch's file list to $WORK/tree and its workflow files
# to $WORK/workflows/, once per run.
fetch_workflows() {
  local branch path
  [ ! -e "$WORK/tree" ] || return 0
  branch=$(jq -r .default_branch "$REPO_JSON")
  # Callers test the result inside "if", where set -e is off: fail explicitly,
  # and never leave a partial list behind for the next call to reuse.
  gh api "repos/$REPO/git/trees/$branch?recursive=1" \
    --jq '.tree[] | select(.type == "blob") | .path' > "$WORK/tree.part" ||
    die "cannot read the file list of $REPO; run it again"
  mkdir -p "$WORK/workflows"
  for path in $(grep -E '^\.github/workflows/[^/]+\.ya?ml$' "$WORK/tree.part" || true); do
    gh api -H 'Accept: application/vnd.github.raw' "repos/$REPO/contents/$path?ref=$branch" \
      > "$WORK/workflows/$(basename "$path")" || die "cannot read $path from $REPO; run it again"
  done
  mv "$WORK/tree.part" "$WORK/tree"
}

# True when the default branch has a ci-ok gate job and a pr-check caller,
# i.e. the checks the main ruleset requires will actually report.
gate_ready() {
  fetch_workflows
  grep -qE '^[[:space:]]+ci-ok:[[:space:]]*$' "$WORK"/workflows/* 2> /dev/null &&
    grep -qE "uses: *($KIT_REPO|\.)/\.github/workflows/pr-check\.yml" "$WORK"/workflows/* 2> /dev/null
}

check_files() {
  step "files"
  local f wf found clean=1
  fetch_workflows
  for f in $REQUIRED_FILES; do
    grep -qxF "$f" "$WORK/tree" || {
      clean=0
      act "missing file $f" true
    }
  done
  for wf in pr-check issue-check release; do
    found=$(grep -lE "uses: *($KIT_REPO|\.)/\.github/workflows/$wf\.yml" "$WORK"/workflows/* 2> /dev/null || true)
    [ -n "$found" ] || {
      clean=0
      act "no workflow calls $KIT_REPO/.github/workflows/$wf.yml" true
    }
  done
  grep -qE '^[[:space:]]+ci-ok:[[:space:]]*$' "$WORK"/workflows/* 2> /dev/null || {
    clean=0
    act "no workflow has a ci-ok gate job" true
  }
  [ "$clean" = 0 ] || log "  ok"
}

# --- commands ------------------------------------------------------------------

# apply_all MIGRATE PRUNE SKIP_RULESETS TOPICS MILESTONE
apply_all() {
  check_settings
  check_topics "$4"
  check_actions
  check_security
  check_labels "$1" "$2"
  check_milestones "$5"
  if [ "$3" = 1 ]; then
    step "rulesets"
    log "  skipped (--skip-rulesets)"
  else
    check_rulesets
  fi
  check_classic_protection
}

cmd_apply() {
  local repo="" migrate=0 prune=0 skip=0 topics="" milestone=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) MODE="dry-run" ;;
      --migrate-labels) migrate=1 ;;
      --prune-labels) prune=1 ;;
      --skip-rulesets) skip=1 ;;
      --topics) topics="${2:?--topics needs a value}"; shift ;;
      --milestone) milestone="${2:?--milestone needs a value}"; shift ;;
      -*) usage_error "apply: unknown option $1" ;;
      *) [ -z "$repo" ] || usage_error "apply: one repository at a time"; repo="$1" ;;
    esac
    shift
  done
  [ -n "$repo" ] || usage_error "apply: missing <owner/repo>"
  [ -z "$milestone" ] || [[ "$milestone" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
    usage_error "--milestone must look like vX.Y.Z"
  load_repo "$repo"
  log "oss-kit apply $REPO ($MODE)"
  apply_all "$migrate" "$prune" "$skip" "$topics" "$milestone"
  if [ "$MODE" = dry-run ]; then
    log ""
    log "$DRIFT change(s) would be made"
  fi
}

cmd_doctor() {
  [ $# -eq 1 ] || usage_error "doctor: expected exactly one <owner/repo>"
  MODE=doctor
  load_repo "$1"
  log "oss-kit doctor $REPO"
  apply_all 0 1 0 "" ""
  check_files
  log ""
  if [ "$DRIFT" -gt 0 ]; then
    log "$DRIFT difference(s) from the spec"
    return 1
  fi
  log "no drift"
}

cmd_new() {
  local name="" description="" topics="" stack=none dir="$HOME/Projects" dry=0 resume=0 target i branch
  while [ $# -gt 0 ]; do
    case "$1" in
      --description) description="${2:?--description needs a value}"; shift ;;
      --topics) topics="${2:?--topics needs a value}"; shift ;;
      --stack) stack="${2:?--stack needs a value}"; shift ;;
      --dir) dir="${2:?--dir needs a value}"; shift ;;
      --dry-run) dry=1 ;;
      --resume) resume=1 ;;
      -*) usage_error "new: unknown option $1" ;;
      *) [ -z "$name" ] || usage_error "new: one name at a time"; name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || usage_error "new: missing <name>"
  [ "$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')" != ".github" ] ||
    die "never create $OWNER/.github: its community files would apply to private repositories too"
  [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || usage_error "new: invalid repository name \"$name\""
  [ -n "$description" ] || usage_error "new: --description is required"
  # Checked before anything exists: a placeholder here would fail the fill
  # after the public repository was already created.
  case "$description" in
    *'{{'* | *'}}'*) usage_error "new: --description must not contain {{ or }}" ;;
  esac
  valid_stack "$stack" || usage_error "new: unknown --stack \"$stack\" (one of: $STACKS)"
  target="$dir/$name"

  step "preflight"
  [ "$(gh api user --jq .login)" = "$OWNER" ] || die "gh is not logged in as $OWNER"
  if [ "$resume" = 1 ]; then
    gh api "repos/$OWNER/$name" > "$WORK/new.json" 2> /dev/null ||
      die "--resume: $OWNER/$name does not exist; run new without --resume"
    [ "$(jq -r '.template_repository.full_name // empty' "$WORK/new.json")" = "$TEMPLATE" ] ||
      die "--resume: $OWNER/$name was not created from $TEMPLATE"
    if [ -e "$target" ]; then
      case "$(git -C "$target" remote get-url origin 2> /dev/null)" in
        *"$OWNER/$name" | *"$OWNER/$name.git") ;;
        *) die "--resume: $target exists but is not a clone of $OWNER/$name" ;;
      esac
    fi
  else
    ! gh api "repos/$OWNER/$name" --silent 2> /dev/null ||
      die "$OWNER/$name already exists (to finish an interrupted new, add --resume)"
    [ "$(gh api "repos/$TEMPLATE" --jq .is_template 2> /dev/null)" = true ] ||
      die "$TEMPLATE is missing or not marked as a template"
    [ ! -e "$target" ] || die "$target already exists"
  fi
  log "  ok"
  if [ "$dry" = 1 ]; then
    log ""
    log "would create $OWNER/$name (public) from $TEMPLATE, clone to $target,"
    log "fill placeholders, add stack \"$stack\" extras, push, then apply with milestone v0.1.0"
    return 0
  fi

  step "create $OWNER/$name"
  if [ "$resume" = 1 ]; then
    log "  exists (resuming)"
  else
    gh repo create "$OWNER/$name" --public --template "$TEMPLATE" --description "$description" > /dev/null
  fi
  # From here on a failure leaves a public repository behind; say how to finish it.
  NEW_HINT="$(shq "$0") new $name --description $(shq "$description") --stack $stack"
  [ -z "$topics" ] || NEW_HINT="$NEW_HINT --topics $(shq "$topics")"
  NEW_HINT="$NEW_HINT --dir $(shq "$dir") --resume"
  i=0
  until gh api "repos/$OWNER/$name/commits?per_page=1" --silent 2> /dev/null; do
    i=$((i + 1))
    [ "$i" -lt 30 ] || die "the template copy did not finish within 60 s"
    sleep 2
  done
  log "  https://github.com/$OWNER/$name"

  step "clone and fill placeholders"
  # A clone made before the template copy finished has no commits; nothing
  # in it can be anyone's work, so start that one over.
  if [ -e "$target" ] && ! git -C "$target" rev-parse -q --verify HEAD > /dev/null &&
    only_git_dir "$target"; then
    log "  replacing the empty clone at $target"
    rm -rf "$target"
  fi
  if [ -e "$target" ]; then
    log "  already cloned at $target"
    resume_check "$target"
  else
    mkdir -p "$dir"
    gh repo clone "$OWNER/$name" "$target" -- --quiet
  fi
  fill_placeholders "$target" "$name" "$description"
  log "  ok"

  if [ "$stack" != none ]; then
    step "stack extras ($stack)"
    add_stack_extras "$target" "$stack"
    log "  .gitignore: $(stack_gitignore "$stack"); dependabot: $(stack_ecosystem "$stack")"
  fi

  step "commit and push (before the rulesets exist)"
  branch=$(git -C "$target" symbolic-ref --short HEAD)
  if [ -n "$(git -C "$target" status --porcelain)" ]; then
    git -C "$target" add -A
    git -C "$target" commit -q -m "chore: initialize from oss-template"
  fi
  git -C "$target" push -q origin "HEAD:$branch"
  log "  pushed to $branch"

  MODE=apply
  load_repo "$OWNER/$name"
  apply_all 0 1 0 "$topics" v0.1.0
  next_steps "$OWNER/$name" "$target" "$stack" >&2
}

# next_steps REPO LOCAL_DIR STACK
next_steps() {
  local title="ci: add $3 CI"
  [ "$3" != none ] || title="<type>: <first change>"
  cat <<EOF

Done: https://github.com/$1  (local: $2)
Next: open the first issue in milestone v0.1.0, then follow the draft-first
flow (docs/conventions.md in $KIT_REPO):
  gh issue create -R $1 --title "$title" --body "<what and why>" --milestone v0.1.0
EOF
}

# only_git_dir DIR — true when DIR holds nothing but .git.
only_git_dir() {
  local f
  for f in "$1"/* "$1"/.[!.]* "$1"/..?*; do
    [ -e "$f" ] || continue
    [ "$(basename "$f")" = .git ] || return 1
  done
}

# shq VALUE — VALUE single-quoted for a shell command line. Unlike printf %q
# it leaves non-ASCII text readable, so a printed command can be copied.
shq() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# resume_check DIR — before new --resume publishes a clone it did not just
# make, refuse anything oss-kit did not write: untracked files, changes to
# files other than the ones it fills or extends, and local commits other than
# its own initialization commit.
resume_check() {
  local dir="$1" branch allowed status line path stray="" commits
  branch=$(git -C "$dir" symbolic-ref --short HEAD)
  git -C "$dir" fetch -q origin
  allowed=$(git -C "$dir" grep -lE '\{\{(YEAR|OWNER|REPO|DESCRIPTION|FULLNAME)\}\}' "origin/$branch" -- 2> /dev/null |
    sed "s#^origin/$branch:##" || true)
  allowed="$allowed
.gitignore
.github/dependabot.yml"
  status=$(git -C "$dir" status --porcelain --untracked-files=all)
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    path=${line:3}
    case "$line" in
      '??'*) stray="$stray
  $path (untracked)" ;;
      *) printf '%s\n' "$allowed" | grep -qxF "$path" || stray="$stray
  $path" ;;
    esac
  done <<< "$status"
  commits=$(git -C "$dir" log --format=%s "origin/$branch..HEAD")
  if [ -n "$commits" ] && [ "$commits" != "chore: initialize from oss-template" ]; then
    stray="$stray
  local commits: $(printf '%s' "$commits" | tr '\n' ';')"
  fi
  [ -z "$stray" ] || die "--resume would publish work that oss-kit did not write in $dir:$stray
Move it aside (or into a branch), then resume; your own work goes in through a pull request."
}

NEW_HINT="" # set by new once the repository exists

on_exit() {
  local rc=$?
  rm -rf "$WORK"
  if [ "$rc" != 0 ] && [ -n "$NEW_HINT" ]; then
    printf '\nnew stopped part-way; the repository exists. Finish it with:\n  %s\n' "$NEW_HINT" >&2
  fi
}

main() {
  local cmd="${1:-}"
  [ $# -eq 0 ] || shift
  for tool in gh git jq perl; do
    command -v "$tool" > /dev/null || die "$tool is required"
  done
  WORK=$(mktemp -d)
  trap on_exit EXIT
  case "$cmd" in
    new) cmd_new "$@" ;;
    apply) cmd_apply "$@" ;;
    doctor) cmd_doctor "$@" ;;
    -h | --help | help) usage ;;
    "") usage_error "missing command" ;;
    *) usage_error "unknown command \"$cmd\"" ;;
  esac
}

if [ "${OSS_KIT_LIB:-}" != 1 ]; then
  main "$@"
fi
